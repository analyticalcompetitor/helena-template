---
import Button from "@/components/ui/Button.astro";
import { whatsappLink } from "@/lib/content";
import type { getHome, getSettings } from "@/lib/content";

interface Props {
  data: Awaited<ReturnType<typeof getHome>>["contact"];
  settings: Awaited<ReturnType<typeof getSettings>>;
}

const { data, settings } = Astro.props;
const wa = whatsappLink(settings.whatsappNumber, settings.whatsappMessage);
---

<section class="contact">
  <div class="container-lp contact-inner">
    <h2 class="t-section contact-title">{data.title}</h2>
    <p class="t-lead contact-text">{data.text}</p>
    <Button href={wa} variant="dark" whatsapp class="contact-btn">{data.buttonLabel}</Button>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background: var(--color-sage);
    padding: 61px 0 60px;
  }

  .contact-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact-title {
    color: var(--color-graphite);
    max-width: 240px;
  }

  .contact-text {
    margin-top: 22px;
    max-width: 300px;
  }

  .contact-inner :global(.contact-btn) {
    margin-top: 30px;
  }

  @media (min-width: 64rem) {
    .contact {
      padding: 53px 0 52px;
    }

    .contact-title {
      max-width: none;
    }

    .contact-text {
      margin-top: 18px;
      max-width: 520px;
    }

    .contact-inner :global(.contact-btn) {
      margin-top: 30px;
    }
  }
</style>

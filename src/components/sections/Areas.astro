---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/icons/Icon.astro";
import { whatsappLink } from "@/lib/content";
import type { getHome, getSettings } from "@/lib/content";

interface Props {
  data: Awaited<ReturnType<typeof getHome>>["areas"];
  settings: Awaited<ReturnType<typeof getSettings>>;
}

const { data, settings } = Astro.props;

const iconSize = { spa: 34, person: 34, syringe: 32 } as const;
---

<section class="areas" id="servicos">
  <div class="container-lp">
    <h2 class="t-section areas-title">{data.title}</h2>

    <ul class="areas-grid">
      {
        data.items.map((item) => (
          <li class="area-card">
            <span class="area-icon">
              <Icon name={item.icon} size={iconSize[item.icon]} />
            </span>
            <h3 class="t-card area-title">{item.title}</h3>
            <p class="t-body area-text">{item.text}</p>
            <Button
              href={whatsappLink(
                settings.whatsappNumber,
                `${settings.whatsappMessage} Tenho interesse em: ${item.title}.`,
              )}
              variant="teal"
              whatsapp
              class="area-btn"
            >
              {data.buttonLabel}
            </Button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .areas {
    position: relative;
    background: var(--color-cream);
    padding: 58px 0 60px;
    scroll-margin-top: 20px;
  }

  .areas-title {
    color: var(--color-teal);
    text-align: center;
  }

  .areas-grid {
    display: grid;
    gap: 20px;
    margin: 36px auto 0;
    max-width: 420px;
  }

  .area-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 300px;
    padding: 17px 20px 20px;
    background: var(--color-mist);
    border-radius: 20px;
    box-shadow: var(--shadow-card);
  }

  .area-icon {
    display: grid;
    place-items: center;
    width: 51px;
    height: 51px;
    border-radius: 10px;
    background: var(--color-teal);
    color: var(--color-mist);
  }

  .area-title {
    margin-top: 16px;
    color: var(--color-teal);
  }

  .area-text {
    margin-top: 8px;
    max-width: 262px;
  }

  .area-card :global(.area-btn) {
    margin-top: auto;
  }

  .area-text {
    margin-bottom: 16px;
  }

  @media (min-width: 64rem) {
    .areas {
      padding: 106px 0 66px;
    }

    .areas-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 23px;
      max-width: none;
      margin-top: 55px;
    }

    .area-card {
      padding: 17px 24px 14px;
    }

    .area-title {
      margin-top: 24px;
    }

    .area-text {
      max-width: 370px;
      margin-top: 14px;
    }
  }
</style>

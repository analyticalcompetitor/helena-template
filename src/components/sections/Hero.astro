---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import Ornament from "@/components/ui/Ornament.astro";
import { mdInline, whatsappLink } from "@/lib/content";
import type { getHome, getSettings } from "@/lib/content";

interface Props {
  data: Awaited<ReturnType<typeof getHome>>["hero"];
  settings: Awaited<ReturnType<typeof getSettings>>;
}

const { data, settings } = Astro.props;
const wa = whatsappLink(settings.whatsappNumber, settings.whatsappMessage);
---

<section class="hero" id="inicio">
  <!-- Mobile: foto de fundo com degradê -->
  <div class:list={["hero-bg lg:hidden", { "is-fallback": !data.imageMobile }]} aria-hidden="true">
    <Image
      src={data.imageMobile ?? data.image}
      alt=""
      widths={data.imageMobile ? [360, 720] : [480, 960]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <Ornament name="mHero" class="orn-m-hero lg:hidden" />
  <Ornament name="dHero" class="orn-d-hero hidden lg:block" />

  <div class="container-lp hero-inner">
    <a href="#inicio" class="hero-logo" aria-label={settings.siteTitle}>
      <Image src={settings.logo} alt={settings.siteTitle} loading="eager" />
    </a>

    <div class="hero-copy">
      <h1 class="t-display hero-title">{data.title}</h1>
      <p class="t-lead hero-text rich" set:html={mdInline(data.text)} />
      <div class="hero-actions">
        <Button href={wa} variant="solid" whatsapp>{data.primaryButton}</Button>
        <Button href="#servicos" variant="light">{data.secondaryButton}</Button>
      </div>
    </div>

    <!-- Desktop: foto em arco -->
    <div class="hero-photo hidden lg:block">
      <Image
        src={data.image}
        alt={data.imageAlt}
        widths={[480, 720, 1152]}
        sizes="(min-width: 1440px) 576px, 40vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-teal);
    color: var(--color-mist);
    min-height: 890px;
  }

  /* ---------- Mobile ---------- */
  /* Foto do topo no celular: caixa de 890px como no Figma (360x800 esticada por cover) */
  .hero-bg {
    position: absolute;
    inset: 0 0 auto;
    height: 890px;
    overflow: hidden;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Sem foto própria para celular: usa a do desktop no mesmo enquadramento do layout */
  .hero-bg.is-fallback img {
    position: absolute;
    top: 107px;
    left: 50%;
    translate: -50% 0;
    width: 435px;
    max-width: none;
    height: auto;
  }
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(82 142 138 / 0) 23%,
      var(--color-teal) 55%
    );
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 0 60px;
  }

  .hero-logo {
    display: flex;
    justify-content: center;
    width: 184px;
    height: 130px;
    padding-top: 13px;
    background: var(--color-teal);
    border-radius: 0 0 92px 92px;
  }
  .hero-logo img {
    width: 148px;
    height: auto;
    align-self: flex-start;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 290px;
  }

  .hero-title {
    max-width: 310px;
  }

  .hero-text {
    margin-top: 22px;
    max-width: 345px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }

  :global(.orn-m-hero) {
    top: 514px;
    left: calc(50% + 35px);
    width: 687px;
    height: 1011px;
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 64rem) {
    .hero {
      min-height: 791px;
    }

    .hero-inner {
      align-items: flex-start;
      text-align: left;
      padding: 92px 0 92px;
    }

    .hero-logo {
      width: auto;
      height: auto;
      padding: 0;
      background: none;
      border-radius: 0;
    }
    .hero-logo img {
      width: clamp(240px, 21.7vw, 312px);
    }

    .hero-copy {
      align-items: flex-start;
      margin-top: 52px;
      max-width: 52%;
    }

    .hero-title {
      max-width: 640px;
    }

    .hero-text {
      margin-top: 12px;
      max-width: 650px;
    }

    .hero-actions {
      flex-direction: row;
      gap: 24px;
      margin-top: 28px;
    }

    .hero-photo {
      position: absolute;
      z-index: 3;
      top: 60px;
      right: 0;
      width: clamp(360px, 40vw, 576px);
      aspect-ratio: 576 / 856;
      border-radius: 999px;
      overflow: hidden;
      box-shadow: var(--shadow-photo);
    }
    .hero-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    :global(.orn-d-hero) {
      top: -178px;
      right: -184px;
      width: 583px;
      height: 1128px;
    }
  }
</style>

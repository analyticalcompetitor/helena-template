---
import { Image } from "astro:assets";
import Ornament from "@/components/ui/Ornament.astro";
import type { getHome } from "@/lib/content";

interface Props {
  data: Awaited<ReturnType<typeof getHome>>["faq"];
}

const { data } = Astro.props;
---

<section class="faq" id="duvidas">
  <Ornament name="mFaq" class="orn-m-faq lg:hidden" />
  <Ornament name="dFaq" class="orn-d-faq hidden lg:block" />

  <div class="container-lp faq-inner">
    <div class="faq-content">
      <h2 class="t-section faq-title">{data.title}</h2>
      <div class="faq-list">
        {
          data.items.map((item, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>
                <span class="faq-q">{item.question}</span>
                <span class="faq-icon" aria-hidden="true" />
              </summary>
              <p class="faq-a">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>

    <div class="faq-photo hidden lg:block">
      <Image src={data.image} alt={data.imageAlt} widths={[560, 840, 1120]} sizes="560px" />
    </div>
  </div>
</section>

<style>
  .faq {
    position: relative;
    background: var(--color-mist);
    padding: 76px 0 61px;
  }

  .faq-title {
    color: var(--color-teal);
  }

  .faq-list {
    margin-top: 34px;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-teal);
  }

  .faq-item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0 15px;
    cursor: pointer;
    list-style: none;
  }
  .faq-item:first-child summary {
    padding-top: 0;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-taupe);
    max-width: 255px;
  }

  /* Círculo verde com "+"; aberto, gira 45° e vira "×" */
  .faq-icon {
    position: relative;
    flex: none;
    width: 21px;
    height: 21px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--color-teal);
    transition: transform 300ms ease-out;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 13px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-sand);
    translate: -50% -50%;
  }
  .faq-icon::after {
    rotate: 90deg;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-a {
    padding: 0 20px 16px 0;
    font-size: 16px;
    line-height: 22px;
    color: var(--color-taupe);
  }

  :global(.orn-m-faq) {
    bottom: -529px;
    left: 8px;
    width: 1073px;
    height: 590px;
    clip-path: inset(0 0 529px 0);
  }

  @media (min-width: 64rem) {
    .faq {
      padding: 100px 0 102px;
    }

    .faq-inner {
      display: grid;
      grid-template-columns: minmax(0, 693px) minmax(0, 560px);
      justify-content: space-between;
      column-gap: 60px;
    }

    .faq-title {
      padding-top: 26px;
    }

    .faq-list {
      margin-top: 40px;
    }

    .faq-item summary {
      align-items: center;
      padding: 18px 3px 16px 0;
    }

    .faq-q {
      font-size: 18px;
      line-height: 24px;
      max-width: none;
    }

    .faq-icon {
      margin-top: -4px;
    }

    .faq-a {
      margin-top: -8px;
      padding-bottom: 17px;
    }

    .faq-photo {
      height: 536px;
      border-radius: 20px;
      overflow: hidden;
    }
    .faq-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    :global(.orn-d-faq) {
      bottom: -376px;
      right: -597px;
      width: 1073px;
      height: 590px;
      clip-path: inset(0 0 376px 0);
    }
  }
</style>
